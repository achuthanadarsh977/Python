> explain class vs instance attributes in few sentences

● Class attributes are shared across all instances — defined directly in the class body. Changing them affects every
  object unless overridden.

  Instance attributes belong to a specific object — defined in __init__ via self. Each object has its own copy.

  class Dog:
      species = "Canis lupus"      # class attribute — shared by all

      def __init__(self, name):
          self.name = name         # instance attribute — unique per object

  d1 = Dog("Rex")
  d2 = Dog("Buddy")

  print(d1.species)   # "Canis lupus"
  print(d2.species)   # "Canis lupus"
  print(d1.name)      # "Rex"
  print(d2.name)      # "Buddy"

  Dog.species = "Wolf"
  print(d1.species)   # "Wolf" — all instances affected

> number guessing game in typescript

● import * as readline from "readline";

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });

  function ask(question: string): Promise<string> {
    return new Promise((resolve) => rl.question(question, resolve));
  }

  async function game(): Promise<void> {
    const secret = Math.floor(Math.random() * 100) + 1;
    const maxAttempts = 7;
    let attempts = 0;

    console.log("\n🎯 Guess the number between 1 and 100!");
    console.log(`You have ${maxAttempts} attempts.\n`);

    while (attempts < maxAttempts) {
      const input = await ask(`Attempt ${attempts + 1}/${maxAttempts}: `);
      const guess = parseInt(input);

      if (isNaN(guess) || guess < 1 || guess > 100) {
        console.log("Enter a valid number between 1 and 100.\n");
        continue;
      }

      attempts++;

      if (guess === secret) {
        console.log(`\n✅ Correct! You guessed it in ${attempts} attempt(s)!`);
        rl.close();
        return;
      }

      const remaining = maxAttempts - attempts;
      if (guess < secret) {
        console.log(`Too low! ${remaining} attempt(s) left.\n`);
      } else {
        console.log(`Too high! ${remaining} attempt(s) left.\n`);
      }
    }

    console.log(`\n❌ Out of attempts! The number was ${secret}.`);
    rl.close();
  }

  game();
